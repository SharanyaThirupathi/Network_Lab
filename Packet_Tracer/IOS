3. Router 3 Configuration Code

text
enable
configure terminal
hostname Router3

! --- CONFIGURE INTERFACES ---
interface GigabitEthernet0/0
 ip address 192.168.3.1 255.255.255.0
 no shutdown
exit

interface Serial0/0/0
