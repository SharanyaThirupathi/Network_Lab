#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/sysinfo.h>

#define MAX_BUF 1024
#define AUTH_USER "admin"
#define AUTH_PASS "mepco123"

void log_activity(const char *client_ip, int client_port, const char *action) {
    FILE *log_file = fopen("server_activity.log", "a");
    if (!log_file) return;

    time_t now = time(NULL);
    char t_str[26];
    ctime_r(&now, t_str);
    t_str[strcspn(t_str, "\n")] = '\0';

    fprintf(log_file, "[%s] Client %s:%d -> %s\n", t_str, client_ip, client_port, action);
    fclose(log_file);
}

void handle_client(int client_sock, const char *client_ip, int client_port) {
    char buffer[MAX_BUF];
    char auth_packet[MAX_BUF * 2];

    // 1. Unified Authentication Phase
    memset(auth_packet, 0, sizeof(auth_packet));
    if (recv(client_sock, auth_packet, sizeof(auth_packet), 0) <= 0) {
        close(client_sock);
        return;
    }

    // Parse username and password using token splitting
    char *username = strtok(auth_packet, ":");
    char *password = strtok(NULL, ":");

    if (username && password && strcmp(username, AUTH_USER) == 0 && strcmp(password, AUTH_PASS) == 0) {
        send(client_sock, "SUCCESS", 8, 0);
        printf("[AUTH] Success: User '%s' logged in from %s:%d\n", username, client_ip, client_port);
        log_activity(client_ip, client_port, "Successfully Authenticated");
    } else {
        send(client_sock, "FAILED", 7, 0);
        printf("[AUTH] Failed login attempt from %s:%d\n", client_ip, client_port);
        log_activity(client_ip, client_port, "Failed Authentication Attempt");
        close(client_sock);
        return;
    }

    // 2. Menu Service Phase
    while (1) {
        int choice = 0;
        if (recv(client_sock, &choice, sizeof(choice), 0) <= 0) break;
        choice = ntohl(choice);

        if (choice == 1) { // Upload File (Client -> Server)
            char filename[MAX_BUF];
            memset(filename, 0, MAX_BUF);
            recv(client_sock, filename, MAX_BUF, 0);

            FILE *fp = fopen(filename, "wb");
            if (fp) {
                int bytes_received;
                while ((bytes_received = recv(client_sock, buffer, MAX_BUF, 0)) > 0) {
                    if (strncmp(buffer, "==EOF==", 7) == 0) break;
                    fwrite(buffer, 1, bytes_received, fp);
                }
                fclose(fp);
                send(client_sock, "ACK", 4, 0);
                log_activity(client_ip, client_port, "Uploaded file successfully");
            } else {
                send(client_sock, "ERR", 4, 0);
            }
        }
        else if (choice == 2) { // Download File (Server -> Client)
            char filename[MAX_BUF];
            memset(filename, 0, MAX_BUF);
            recv(client_sock, filename, MAX_BUF, 0);

            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                send(client_sock, "ERR", 4, 0);
                log_activity(client_ip, client_port, "Attempted download - File not found");
            } else {
                send(client_sock, "OK", 3, 0);
                int bytes_read;
                while ((bytes_read = fread(buffer, 1, MAX_BUF, fp)) > 0) {
                    send(client_sock, buffer, bytes_read, 0);
                }
                fclose(fp);
                usleep(50000); // Prevent stream merging with EOF marker
                send(client_sock, "==EOF==", 8, 0);
                log_activity(client_ip, client_port, "Downloaded file successfully");
            }
        }
        else if (choice == 3) { // Date and Time
            time_t now = time(NULL);
            char *dt_str = ctime(&now);
            send(client_sock, dt_str, strlen(dt_str) + 1, 0);
            log_activity(client_ip, client_port, "Requested Server Date/Time");
        }
        else if (choice == 4) { // System Info
            struct sysinfo si;
            sysinfo(&si);
            snprintf(buffer, MAX_BUF, "Uptime: %lds, Total RAM: %luMB, Free RAM: %luMB",
                     si.uptime, si.totalram / (1024*1024), si.freeram / (1024*1024));
            send(client_sock, buffer, strlen(buffer) + 1, 0);
            log_activity(client_ip, client_port, "Requested System Information");
        }
        else if (choice == 5) { // Exit
            log_activity(client_ip, client_port, "Terminated Session Gracefully");
            printf("[System] Client %s:%d closed connection.\n", client_ip, client_port);
            break;
        }
    }
    close(client_sock);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: %s <Port>\n", argv[0]);
        return 1;
    }

    int port = atoi(argv[1]);
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(port);

    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        return 1;
    }

    listen(server_fd, 5);
    printf("Multi-Service TCP Server initiated on port %d...\n", port);

    while (1) {
        int client_sock = accept(server_fd, (struct sockaddr *)&client_addr, &addr_len);
        char *ip = inet_ntoa(client_addr.sin_addr);
        int c_port = ntohs(client_addr.sin_port);

        printf("[Connection] Received connection link from %s:%d\n", ip, c_port);
        handle_client(client_sock, ip, c_port);
    }

    close(server_fd);
    return 0;
}
