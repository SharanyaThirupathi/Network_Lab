#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>

#define MAX_BUF 1024

int main(int argc, char *argv[]) {
    if (argc < 3) {
        printf("Usage: %s <Server IP> <Port>\n", argv[0]);
        return 1;
    }

    int sock = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in server_addr;

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(atoi(argv[2]));
    inet_pton(AF_INET, argv[1], &server_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection failed");
        return 1;
    }

    // 1. Packaged Authentication Layer
    char username[MAX_BUF], password[MAX_BUF], status[MAX_BUF];
    char auth_packet[MAX_BUF * 2];

    printf("--- Server Authentication Requirement ---\n");
    printf("Username: "); scanf("%s", username);
    printf("Password: "); scanf("%s", password);

    // Format credentials cleanly into user:password format
    snprintf(auth_packet, sizeof(auth_packet), "%s:%s", username, password);
    send(sock, auth_packet, strlen(auth_packet) + 1, 0);

    memset(status, 0, MAX_BUF);
    recv(sock, status, MAX_BUF, 0);

    if (strcmp(status, "SUCCESS") != 0) {
        printf("[Access Denied] Invalid username or password.\n");
        close(sock);
        return 1;
    }
    printf("[System] Login Success verified!\n\n");

    // 2. Loop Interactive Services Menu
    while (1) {
        int choice;
        char buffer[MAX_BUF], filename[MAX_BUF];

        printf("=== MULTI-SERVICE SYSTEM MENU ===\n");
        printf("1. Upload a File\n");
        printf("2. Download a File\n");
        printf("3. Retrieve Server Date & Time\n");
        printf("4. Display Server Hardware Specs\n");
        printf("5. Disconnect Session\n");
        printf("Select option [1-5]: ");
        scanf("%d", &choice);

        int net_choice = htonl(choice);
        send(sock, &net_choice, sizeof(net_choice), 0);

        if (choice == 1) { // Upload
            printf("Enter filepath to upload: ");
            scanf("%s", filename);
            FILE *fp = fopen(filename, "rb");
            if (!fp) {
                printf("Error: Local file does not exist.\n\n");
                continue;
            }
            send(sock, filename, strlen(filename) + 1, 0);
            int bytes_read;
            while ((bytes_read = fread(buffer, 1, MAX_BUF, fp)) > 0) {
                send(sock, buffer, bytes_read, 0);
            }
            fclose(fp);
            usleep(50000);
            send(sock, "==EOF==", 8, 0);

            recv(sock, buffer, MAX_BUF, 0);
            printf("[System] File delivery status: %s\n\n", buffer);
        }
        else if (choice == 2) { // Download
            printf("Enter filename located on server to fetch: ");
            scanf("%s", filename);
            send(sock, filename, strlen(filename) + 1, 0);

            recv(sock, buffer, 3, 0);
            if (strncmp(buffer, "ERR", 3) == 0) {
                printf("Error: File does not exist on server.\n\n");
            } else {
                FILE *fp = fopen(filename, "wb");
                int bytes_rec;
                while ((bytes_rec = recv(sock, buffer, MAX_BUF, 0)) > 0) {
                    if (strncmp(buffer, "==EOF==", 7) == 0) break;
                    fwrite(buffer, 1, bytes_rec, fp);
                }
                fclose(fp);
                printf("[Success] Download saved successfully.\n\n");
            }
        }
        else if (choice == 3 || choice == 4) { // Diagnostics Handlers
            memset(buffer, 0, MAX_BUF);
            recv(sock, buffer, MAX_BUF, 0);
            printf("\n[Server Response Data]: %s\n\n", buffer);
        }
        else if (choice == 5) { // Exit
            printf("Terminating connection safely.\n");
            break;
        }
    }

    close(sock);
    return 0;
}
